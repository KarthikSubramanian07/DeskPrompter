# Cross-origin isolation for in-browser speech recognition (Moonshine needs
# SharedArrayBuffer for WebAssembly threads). Everything the app loads is
# same-origin or a CORS fetch, so require-corp blocks nothing we use.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
